<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v0.13 : savoir quand CarPlay passe au premier plan (autorisation donnée à la main dans les réglages). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <!-- Adaptateur OBD2 ELM327 / Vgate iCar Pro 2S (Bluetooth classique SPP + Bluetooth Low Energy BLE) -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- v0.15 : retrouver les applis son de l'autoradio (copiées sur la clé pour étude, jamais modifiées). -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- v0.16 : fermer les applis qui traînent en arrière-plan (jamais celle à l'écran). -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- v0.30 : basses selon le volume (égaliseur d'Android sur tout le son). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- v0.35, essai : micro de l'autoradio enregistré une minute à la demande du PC (MicTest). Jamais demandé à
         l'écran : l'autorisation n'est donnée que par le PC en ADB, le temps de l'essai. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <queries>
        <package android:name="com.syu.ms" />
        <package android:name="com.syu.eq" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:icon="@mipmap/ic_launcher"
        android:label="Lanceur 308"
        android:supportsRtl="false"
        android:theme="@style/Theme.Lanceur">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Désactivé par défaut : on ne remplace le lanceur d'origine que si tu l'actives dans Réglages. -->
        <activity-alias
            android:name=".HomeAlias"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".service.VehicleWatchService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- v0.35, essai du micro : commandes réservées au PC en ADB (autorisation DUMP, que les applis n'ont pas). -->
        <receiver
            android:name=".sound.MicTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- v0.31 : balance « Seul / Passagers ». Touche l'égaliseur FYT (com.syu.eq) à la place du doigt, seulement
             quand on le demande. Inactif tant qu'il n'est pas activé à la main dans Android, Accessibilité. -->
        <service
            android:name=".sound.ChampService"
            android:exported="true"
            android:label="Lanceur 308 : balance Seul / Passagers"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/champ_service" />
        </service>
    </application>
</manifest>
